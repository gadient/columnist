# Keep the build context tiny and secret-free.
.venv/
__pycache__/
*.pyc
*.pyo

# Never ship local secrets or config — env comes from ECS task / SSM.
.env
.env.*

# Local SQLite data, logs, runtime pids. Not used in prod.
data/
*.sqlite
*.sqlite-*
*.log

# Dev noise
.DS_Store
.pytest_cache/
.mypy_cache/
tests/
