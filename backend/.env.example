# backend/.env.example — copy to backend/.env and adjust. Secrets-free template (never commit .env).
# Keys mirror app/config.py (Settings). Unlisted settings use their code defaults.

# ── Server ──
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ── Database ──
# Local dev uses SQLite. For the deployed backend set DATABASE_URL to a postgres:// URL (RDS);
# db.py then switches to psycopg — same code path + migrations. Leave DATABASE_URL empty for SQLite.
SQLITE_PATH=../data/columnist.sqlite
DATABASE_URL=

# ── Agent / MCP ──
# AGENT_BACKEND selects the model backend for BOTH agents (chat and notes-to-cards). Restart the app
# after changing anything in this file: it is read once at startup. Full setup: README.md,
# "Turning on the AI agents".
#   offline    no cloud model. Chat and notes-to-cards tell users they are switched off, and the
#              server log says what to set. Free, deterministic, what the tests run against.
#              The default.
#   openai     the OpenAI API. Needs OPENAI_API_KEY below.
#   anthropic  the Anthropic API. Needs ANTHROPIC_API_KEY below.
#   bedrock    Amazon Bedrock's Converse API. Needs AWS credentials exported in the SHELL that starts
#              the app, never in this file: nothing here is exported to the AWS SDK.
#
# ⚠️ Quality measured on one model does NOT carry to another. The published extraction and chat
# results were measured on Claude Sonnet 4.5 via bedrock; any other model needs its own eval run.
AGENT_BACKEND=offline

# Only read when AGENT_BACKEND=openai. API keys are real secrets: this file is git-ignored, and the
# pre-commit gitleaks hook blocks a key if one is ever staged.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Only read when AGENT_BACKEND=anthropic. Newer Claude models reject the `temperature` the agents
# send; claude-sonnet-4-5 accepts it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Only read when AGENT_BACKEND=bedrock. Keep the model pinned: the code default is Amazon Nova 2 Lite,
# which failed the extraction quality gate; Sonnet 4.5 is the model that passed. The `us.` profile
# needs a US region. Set the region HERE: AWS_REGION in this file is ignored, and boto3 reads
# AWS_DEFAULT_REGION (not AWS_REGION) from the shell. Empty falls back to your AWS profile's region.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_REGION=

MCP_ALLOWED_BOARD_IDS=
MCP_MAX_RESULT_LIMIT=50

# ── Auth (Cognito, Backend-for-Frontend) ──
# Leave COGNITO_* blank to keep auth DISABLED (all routes open — local dev). When set, the app
# enforces auth on every /api/v1 route except /health and the /auth/* bootstrap endpoints (config,
# me, and the login/reset calls — you cannot require a session to sign in), and needs
# PyJWT[crypto] + boto3 (already in requirements).
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
# Confidential app-client secret — .env / SSM ONLY, NEVER commit. In prod it comes from SSM
# (deploy/set-cognito-env.sh), not this file.
COGNITO_APP_CLIENT_SECRET=

# Session cookies (the browser never holds a raw token — the backend sets httpOnly cookies).
# AUTH_COOKIE_SECURE must be true in production (HTTPS); false for local http dev.
AUTH_COOKIE_SECURE=false
# Session length. MUST match the Cognito app-client id/access-token validity.
AUTH_COOKIE_TTL_SECONDS=43200   # 12h

# ── Caps (a private Instance per invited user) ──
MAX_INSTANCES=10                # private Instances the operator may create (excl. default)
MAX_PRIMARY_USERS=1             # PIUs per Instance — one user solely owns each Instance
MAX_SECONDARY_PER_PRIMARY=5     # SIUs each PIU may invite into their own space
MAX_WORKSPACE_MEMBERS=5

# ── Token cost guards (active only when Cognito is on) ──
MAX_TOKENS_PER_USER_PER_DAY=100000
MAX_TOKENS_PER_DOCUMENT=12000

# ── No-auth opt-in (LOCAL DEV ONLY) ──
# The server refuses to start with auth disabled unless this is true. Never set in production —
# configure COGNITO_* instead. The fail-closed startup guard is in app/main.py.
ALLOW_INSECURE_NO_AUTH=true
