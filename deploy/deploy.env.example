# deploy/deploy.env — deployment-specific identifiers for the ops scripts.
#
# Copy this file to deploy/deploy.env (git-ignored) and fill in your values as
# docs/DEPLOY.md creates them. Each hint shows the AWS CLI command that prints the value.

# ── Values you choose ─────────────────────────────────────────────────────────
# Where the budget alarm and error alerts are emailed (bring-up.sh budget phase, alerts.sh).
ALERT_EMAIL=
# Optional: your own address, only for the IP-locked private-testing stage (DEPLOY.md §7).
#   curl -s https://checkip.amazonaws.com        # IPv4, as a /32
DEPLOY_ALLOWED_IPV6_CIDR=
DEPLOY_ALLOWED_IPV4_CIDR=

# ── Values AWS hands back ─────────────────────────────────────────────────────

# ECS service name (has a random suffix).
#   aws ecs list-services --cluster default --query 'serviceArns' --output text
SERVICE=

# ALB name created by ECS Express.
#   aws elbv2 describe-load-balancers --query 'LoadBalancers[].LoadBalancerName' --output text
ALB_NAME=

# CloudFront distribution id and its public domain.
#   aws cloudfront list-distributions \
#     --query 'DistributionList.Items[].{id:Id,domain:DomainName,origin:Origins.Items[0].DomainName}' \
#     --output table
CLOUDFRONT_DIST_ID=
CLOUDFRONT_DOMAIN=

# Backend host the gateway ALB routes to (the *.on.aws host-header value).
#   ALB_ARN=$(aws elbv2 describe-load-balancers --names <alb-name> --query 'LoadBalancers[0].LoadBalancerArn' --output text)
#   L=$(aws elbv2 describe-listeners --load-balancer-arn "$ALB_ARN" --query "Listeners[?Port==\`443\`].ListenerArn|[0]" --output text)
#   aws elbv2 describe-rules --listener-arn "$L" --query 'Rules[].Conditions[?Field==`host-header`].Values[]' --output text
API_HOST=

# ── Cognito — needed by invite-primary.sh / set-cognito-env.sh ────────────────
# Non-secret ids. The app-client SECRET is never stored here — it lives only in
# SSM (set once via ./set-cognito-env.sh).
#   aws cognito-idp list-user-pools --max-results 20 \
#     --query 'UserPools[].{name:Name,id:Id}' --output table
COGNITO_USER_POOL_ID=
#   aws cognito-idp list-user-pool-clients --user-pool-id <POOL> \
#     --query 'UserPoolClients[].{name:ClientName,id:ClientId}' --output table
COGNITO_APP_CLIENT_ID=

# ── Bedrock agent backend — needed by set-agent-backend.sh ────────────────────
# Turns the notes-to-cards / chat agents on in prod. All non-secret (boto3 gets
# credentials from the task role, not from here). Model + strategy default in
# config.sh to Claude Sonnet 4.5 on `tool`, the combination that passed the extraction quality bar.
#   BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
#   BEDROCK_STRUCTURED_OUTPUT=tool          # or json_schema (runs, but over-extracts on Sonnet)
#   BEDROCK_REGION=                          # blank ⇒ deploy REGION; set for a cross-region profile
#
# The ECS *task role* that carries bedrock:InvokeModel(+WithResponseStream). Leave
# BLANK to keep the task's existing role (e.g. the ECS-Exec one) and just attach the
# Bedrock policy to it; set it to CREATE/replace the task's role. See DEPLOY.md → Bedrock.
#   aws iam list-roles --query 'Roles[?contains(RoleName,`kanban`)].Arn' --output text
BEDROCK_TASK_ROLE_ARN=

# Optional overrides — defaults live in config.sh and bring-up.sh (keep the two in agreement):
#   REGION=us-east-1  CLUSTER=default  ECR_REPO=kanban-backend  IMAGE_TAG=v1
#   RDS_ID=kanban-db  SSM_PARAM=/kanban/DATABASE_URL
#   COGNITO_SSM_SECRET_PARAM=/kanban/COGNITO_APP_CLIENT_SECRET
#   EXEC_ROLE_NAME=ecsTaskExecutionRole  TASK_ROLE_NAME=kanban-task-bedrock
#   POOL_NAME=kanban-users  BUDGET_NAME=kanban-monthly
